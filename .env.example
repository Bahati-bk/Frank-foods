# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Shared PostgreSQL API (server-side only; never use VITE_ prefixes for secrets)
DATABASE_URL="https://xbatvmjdrynrtugapul.supabase.co"

SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# JSON array of staff accounts, each with a scrypt password hash.
STAFF_ACCOUNTS_JSON="[]"
# Set true only when using the Netlify Functions API in local development.
VITE_SHARED_API_ENABLED="false"


